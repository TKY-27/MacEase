            "state": "translated",
            "value": "ライセンス表記を開けませんでした: %@"
          }
        }
      }
    },
    "The old history was kept as %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の履歴は %@ として保存しました。"
          }
        }
      }
    },
    "The original could not be moved to the Trash, so both files were kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルをゴミ箱に移動できなかったため、両方のファイルを残しました。"
          }
        }
      }
    },
    "The original moves to the Trash. Undo puts it back.": {
      "comment": "Output mode detail",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルはゴミ箱に移動します。「取り消す」で元に戻せます。"
          }
        }
      }
    },
    "The original of “%@” is no longer in the Trash.": {
      "localizations": {
