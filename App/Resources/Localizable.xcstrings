    },
    "“%@” exceeds the frame memory budget. Use fewer or smaller frames.": {
      "comment": "Limit protects available memory",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフレーム用のメモリ上限を超えています。フレーム数を減らすか、サイズを小さくしてください。"
          }
        }
      }
    },
    "“%@” had nothing to remove.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には削除するものがありませんでした。"
          }
        }
      }
    },
    "Couldn’t convert “%@”: line %lld contains characters unsupported by Shift_JIS. Use UTF-8 or allow character replacement.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を変換できませんでした：%2$lld 行に Shift_JIS で表せない文字があります。UTF-8 を選ぶか、文字の置き換えを許可してください。"
          }
        }
      }
    },
    "Couldn’t process “%@”: only one audio and one video track are supported. Export a copy with those tracks in another app.": {
      "comment": "Replacement would discard additional tracks",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を処理できませんでした：音声と映像は各 1 トラックのみ対応しています。別のアプリでその構成のコピーを書き出してください。"
          }
        }
      }
    },
    "“%@” is a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダです。"
          }
        }
      }
    },
    "“%@” is already SDR and was kept without re-encoding.": {
      "localizations": {
        "ja": {
