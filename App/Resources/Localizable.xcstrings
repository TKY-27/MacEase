    "Refresh Networks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを更新"
          }
        }
      }
    },
    "Connect to a private Wi-Fi or Ethernet network to share files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを共有するには、プライベートWi-FiまたはEthernetに接続してください。"
          }
        }
      }
    },
    "Use the same trusted network. HTTP is not encrypted. Files stay on this Mac; no cloud service or internet port forwarding is used.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる同じネットワークを使ってください。HTTP通信は暗号化されません。ファイルはこのMac内にあり、クラウドサービスやインターネットへのポート転送は使いません。"
          }
        }
      }
    },
    "Stop Sharing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を停止"
          }
        }
      }
    },
    "Start Sharing": {
      "localizations": {
