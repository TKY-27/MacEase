            "state": "translated",
            "value": "履歴を保存できなかったため、取り消しはできません。"
          }
        }
      }
    },
    "Undone": {
      "comment": "Recent batch state",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消し済み"
          }
        }
      }
    },
    "Unknown size": {
