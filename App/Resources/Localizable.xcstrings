          }
        }
      }
    },
    "The SDR output does not contain Dolby Vision dynamic metadata.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDR 出力には Dolby Vision のダイナミックメタデータが含まれません。"
          }
        }
      }
    },
    "The narrowest ratio must not be wider than the widest.": {
      "localizations": {
