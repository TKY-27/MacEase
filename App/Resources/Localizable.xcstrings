    },
    "Accessibility": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "Places the preview beside Finder windows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderウインドウの横にプレビューを表示します。"
          }
        }
      }
    },
    "Automation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーション"
          }
        }
      }
    },
    "Lets the preview follow the selection in Finder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで選択した項目をプレビューに表示します。"
          }
        }
      }
    },
    "MacEase asks for this next.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあとMacEaseが許可を求めます。"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        }
      }
    },
    "This file is from the internet. Scripts, external content and other files are disabled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはインターネットから入手したものです。スクリプト、外部コンテンツ、ほかのファイルの読み込みは無効です。"
          }
        }
      }
    },
    "From the internet: limited preview": {
      "localizations": {
