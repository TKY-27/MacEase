          }
        }
      }
    },
    "VBR quality": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VBR の品質"
          }
        }
      }
    },
    "VP9 with alpha (WebM)": {
      "comment": "Transparent video format",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルファチャンネル付き VP9 (WebM)"
          }
        }
      }
    },
    "Variable bitrate (VBR)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可変ビットレート (VBR)"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@ (%@)"
          }
        }
      }
    },
    "Versions and recent log lines, for a bug report.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合の報告に使用する、バージョンと最近のログです。"
          }
        }
      }
    },
    "Video": {
      "comment": "Preset section",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画"
          }
        }
      }
    },
    "Video codec": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画コーデック"
          }
        }
      }
    },
    "Video format": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の形式"
          }
        }
      }
    },
    "Welcome to MacEase": {
      "comment": "Onboarding window title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase へようこそ"
          }
        }
      }
    },
    "When MacEase is already running, the Finder menu responds instantly. MacEase stays in the menu bar and uses almost no resources while idle.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase が起動していれば、Finder のメニューからすぐに操作できます。MacEase はメニューバーに常駐し、待機中はほとんどリソースを使用しません。"
          }
        }
      }
    },
    "When off, every CSV value converts as text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、CSV のすべての値をテキストとして変換します。"
          }
        }
      }
    },
    "Widest ratio": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大の縦横比"
          }
        }
      }
    },
    "Width": {
      "comment": "Resize mode",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅"
          }
        }
      }
    },
    "Width (pixels)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅 (ピクセル)"
          }
        }
      }
    },
    "Window": {
      "comment": "Main menu title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ"
          }
        }
      }
    },
    "With no language chosen, MacEase detects the language automatically.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を選択しない場合、MacEase が自動的に言語を判別します。"
          }
        }
      }
    },
    "Your edits to this preset are removed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットへの変更内容は削除されます。"
          }
        }
      }
    },
    "macOS is running MacEase from a temporary copy, so the Finder menu cannot reach it. Quit MacEase, drag it into the Applications folder, then open it from there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が MacEase の一時コピーを実行しているため、Finder のメニューからアクセスできません。MacEase を終了し、アプリケーションフォルダにドラッグしてから、そこから開いてください。"
          }
        }
      }
    },
