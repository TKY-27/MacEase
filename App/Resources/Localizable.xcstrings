      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真に編集をコピー"
          }
        }
      }
    },
    "Copy this photo's edits to the selected photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の編集内容を選択した写真にコピーします"
