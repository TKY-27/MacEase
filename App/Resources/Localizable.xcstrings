        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はこれ以上小さくできません。"
          }
        }
      }
    },
    "“%@” is already smaller than the requested size.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はすでに指定サイズより小さいです。"
          }
        }
      }
    },
    "Couldn’t process “%@”: the file is empty. Choose a file with content.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を処理できませんでした：ファイルが空です。内容のあるファイルを選んでください。"
          }
        }
      }
    },
    "Couldn’t process “%@”: it exceeds %@. Choose a smaller file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を処理できませんでした：%2$@ を超えています。小さいファイルを選んでください。"
          }
        }
      }
    },
    "Couldn’t process “%@”: it exceeds this preset’s duration limit (%@). Trim it or choose another preset.": {
      "comment": "Platform preset duration limit; the Trim panel opens next",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を処理できませんでした：プリセットの時間制限（%2$@）を超えています。短く切り取るか別のプリセットを選んでください。"
          }
        }
      }
    },
    "“%@” is not a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダではありません。"
          }
        }
      }
    },
    "“%@” is not a regular file or folder. Select a regular file or folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は通常のファイルまたはフォルダではありません。通常のファイルかフォルダを選択してください。"
          }
        }
      }
    },
    "Couldn’t read “%@”: invalid JSON at line %lld, column %lld. Correct the syntax, then retry.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を読み込めませんでした：%2$lld 行 %3$lld 列の JSON 構文が無効です。構文を修正してから再試行してください。"
          }
        }
      }
    },
    "“%@” is on a volume without a Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はゴミ箱のないボリュームにあります。"
          }
        }
      }
    },
    "Couldn’t process “%@”: it is password-protected. Unlock a copy before retrying.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を処理できませんでした：パスワードで保護されています。コピーの保護を解除してから再試行してください。"
          }
        }
      }
    },
    "Couldn’t extract “%@”: a password is required. Enter the archive password.": {
      "comment": "Archive extraction needs a password; the Password panel opens next",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
