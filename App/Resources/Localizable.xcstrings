            "value": "動画のメタデータ"
          }
        }
      }
    },
    "Couldn’t compress “%@” below the target: the smallest result was %@. Choose a larger target size.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を目標容量以下に圧縮できませんでした：最小の結果は %2$@ でした。目標容量を大きくしてください。"
          }
        }
      }
    },
    "“%@” cannot preserve transparency in this output. Choose Save as New File to flatten onto the video background color.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この出力形式では “%@” の透明部分を保持できません。「新しいファイルとして保存」を選ぶと、動画の背景色で透明部分を塗りつぶします。"
          }
        }
      }
    },
    "“%@” cannot replace the original because its audio metadata cannot be preserved. Choose Save as New File.": {
      "comment": "Refuses audio metadata loss on replacement",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声のメタデータを保持できないため、“%@” で元のファイルを置き換えられません。「新しいファイルとして保存」を選んでください。"
          }
        }
      }
    },
    "“%@” cannot replace the original because the output would lose %@ metadata. Choose Save as New File.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力すると %2$@ のメタデータが失われるため、“%1$@” で元のファイルを置き換えられません。「新しいファイルとして保存」を選んでください。"
          }
        }
      }
    },
    "“%@” cannot replace the original because the output would lose %@. Choose Save as New File.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力すると%2$@が失われるため、“%1$@” で元のファイルを置き換えられません。「新しいファイルとして保存」を選んでください。"
          }
        }
      }
    },
    "“%@” cannot replace the original because the output would lose Dolby Vision dynamic metadata. Choose Save as New File.": {
      "comment": "Refuses Dolby Vision metadata loss",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力すると Dolby Vision の動的メタデータが失われるため、“%@” で元のファイルを置き換えられません。「新しいファイルとして保存」を選んでください。"
          }
        }
      }
    },
    "“%@” cannot replace the original because the output would lose HDR. Choose Save as New File or Convert > SDR to tone-map it to SDR.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力すると HDR が失われるため、“%@” で元のファイルを置き換えられません。「新しいファイルとして保存」または「変換 > SDR」を選ぶと、SDR にトーンマッピングします。"
          }
        }
      }
    },
    "“%@” cannot replace the original because the output would lose transparency. Choose Save as New File to flatten onto the configured background color.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力すると透明部分が失われるため、“%@” で元のファイルを置き換えられません。「新しいファイルとして保存」を選ぶと、設定した背景色で透明部分を塗りつぶします。"
          }
        }
      }
