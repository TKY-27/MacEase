    "Reduces speech noise. Exports mono WAV at 16 kHz; stereo is mixed to mono. Maximum 10 minutes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の背景ノイズを抑え、16 kHz・モノラルのWAVに保存します。ステレオはモノラルになります。上限10分。"
          }
        }
      }
    },
    "Exports vocals and instrumental as two stereo WAV files at 44.1 kHz. Maximum 5 minutes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボーカルと伴奏を、44.1 kHz・ステレオの2つのWAVに保存します。上限5分。"
          }
        }
      }
    },
    "Processed on this Mac. Your original is kept. Tags are not copied.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac内で処理し、元ファイルは残します。タグ情報はコピーされません。"
          }
        }
      }
    },
    "Confirm password": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを確認"
          }
        }
      }
    },
    "Use at least 12 characters for a new password. A forgotten password cannot be recovered.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいパスワードは12文字以上にしてください。忘れたパスワードは復元できません。"
          }
        }
      }
    },
    "The original file will be kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元ファイルは保持されます。"
          }
        }
      }
    },
    "The QR code could not be created.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを作成できませんでした。"
          }
        }
      }
    },
    "Selected files": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイル"
          }
        }
      }
    },
    "Share on this network": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークで共有"
          }
        }
      }
    },
    "QR code for shared files": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ファイルのQRコード"
