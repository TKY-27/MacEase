    "Visually similar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目が似ている"
          }
        }
      }
    },
    "%lld files scanned": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイルを検索しました"
          }
        }
      }
    },
    "Designed for small images. Processing can take several minutes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな画像向けの機能です。処理には数分かかる場合があります。"
          }
        }
      }
    },
    "Choose an image containing at most 1 megapixel.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100万画素以下の画像を選択してください。"
          }
        }
      }
    },
    "yt-dlp": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp"
          }
        }
      }
    },
    "%lld images": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像 %lld 枚"
          }
        }
      }
    },
    "Expires in %lld seconds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと %lld 秒で終了"
          }
        }
      }
    },
    "Couldn’t unlock “%@”: the password is incorrect or the file is damaged. Check the password or use an intact copy.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を復号できませんでした：パスワードが違うか、ファイルが破損しています。パスワードを確認するか、破損していないコピーを使用してください。"
          }
        }
      }
    },
    "Source: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元ファイル: %@"
          }
        }
      }
    },
    "%lld unreadable files skipped": {
      "localizations": {
