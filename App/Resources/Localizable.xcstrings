    "“%@” cannot get under the target size. The smallest result was %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を目標サイズ以下にできませんでした。最小の結果は %2$@ でした。"
          }
        }
      }
    },
    "“%@” changed after MacEase saved it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は MacEase が保存した後に変更されています。"
          }
        }
      }
    },
    "“%@” could not be converted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を変換できませんでした。"
          }
        }
      }
    },
    "“%@” could not be processed: %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を処理できませんでした: %2$@。"
          }
        }
      }
    },
    "“%@” could not be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を読み込めませんでした。"
          }
        }
      }
    },
    "“%@” could not be saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を保存できませんでした。"
          }
        }
      }
    },
    "“%@” does not contain what its name suggests.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の中身が拡張子と一致しません。"
          }
        }
      }
    },
    "“%@” had nothing to remove.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には削除するものがありませんでした。"
          }
        }
      }
    },
    "“%@” has characters on line %lld that Shift_JIS cannot represent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” の %2$lld 行目に Shift_JIS で表現できない文字があります。"
          }
        }
      }
    },
    "“%@” is a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダです。"
          }
        }
      }
    },
    "“%@” is already as small as it gets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はこれ以上小さくできません。"
          }
        }
      }
    },
    "“%@” is already smaller than the requested size.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はすでに指定サイズより小さいです。"
          }
        }
      }
    },
    "“%@” is empty.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は空です。"
          }
        }
      }
    },
    "“%@” is larger than %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は %2$@ を超えています。"
          }
        }
      }
    },
    "“%@” is not a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダではありません。"
          }
        }
      }
    },
    "“%@” is not valid JSON (line %lld, column %lld).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は正しい JSON ではありません (%2$lld 行、%3$lld 列)。"
          }
        }
      }
    },
    "“%@” is on a volume without a Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はゴミ箱のないボリュームにあります。"
          }
        }
      }
    },
    "“%@” is too small for an icon.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はアイコンにするには小さすぎます。"
          }
        }
      }
    },
    "“%@” must be an array of flat objects; %@ is not.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” はフラットなオブジェクトの配列である必要があります。%2$@ が該当しません。"
          }
        }
      }
    },
    "“%@” needed no change.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は変更の必要がありませんでした。"
          }
        }
      }
    },
    "“%@” uses %@, which MacEase does not support.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は MacEase が対応していない %2$@ を使用しています。"
