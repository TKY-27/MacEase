    "Applies when the audio is converted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を変換する場合に適用されます。"
          }
        }
      }
    },
    "The selected items share no resolution, so each downloads at its best.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目に共通の解像度がないため、それぞれ最高画質でダウンロードします。"
          }
        }
      }
    },
    "Choose Download Folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード先フォルダを選択"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択"
          }
        }
      }
    },
    "Original Format": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の形式"
          }
        }
      }
    },
    "Copy Edits to Selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した写真に編集をコピー"
