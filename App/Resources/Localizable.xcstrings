{
  "sourceLanguage": "en",
  "strings": {
    "Analyze Links (⌘R)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを解析（⌘R）"
          }
        }
      }
    },
    "Paste or drop gallery links": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリーのリンクをペーストまたはドロップ"
          }
        }
      }
    },
    "Paste or drop video links": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画のリンクをペーストまたはドロップ"
          }
        }
      }
    },
    "Downloads": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        }
      }
    },
    "No Re-encoding": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再エンコードなし"
          }
        }
      }
