          "stringUnit": {
            "state": "translated",
            "value": "インターネットから入手：制限付きプレビュー"
          }
        }
      }
    },
    "Runs this page's scripts until MacEase quits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEaseを終了するまで、このページのスクリプトを実行します。"
          }
        }
      }
    },
    "Loads content from the internet. Scripts run too.": {
      "localizations": {
