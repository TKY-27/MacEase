    "this location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所"
          }
        }
      }
    },
    "“%@” cannot get under the target size. The smallest result was %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を目標サイズ以下にできませんでした。最小の結果は %2$@ でした。"
          }
        }
      }
    },
    "“%@” changed after MacEase saved it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は MacEase が保存した後に変更されています。"
          }
        }
      }
    },
    "“%@” changed after it was scanned, so it was kept.": {
      "comment": "Skip reason when a scanned duplicate or empty folder no longer qualifies",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はスキャン後に変更されたため、そのまま残しました。"
          }
        }
      }
    },
    "“%@” contains chained Ogg streams, which MacEase does not support. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には連結された Ogg ストリームが含まれていますが、MacEase は対応していません。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” contains non-finite audio samples and could not be decoded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には数値として無効な音声サンプルが含まれているため、デコードできませんでした。"
          }
        }
      }
    },
    "“%@” contains streams or chapters that this operation cannot preserve. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には、この操作で保持できないストリームまたはチャプタが含まれています。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be converted because its animation loop count cannot be preserved. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションの繰り返し回数を保持できないため、“%@” を変換できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be converted because the output cannot preserve every frame or page. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力形式ではすべてのフレームまたはページを保持できないため、“%@” を変換できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be converted because the output cannot preserve its audio channel layout. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力形式で音声のチャンネル構成を保持できないため、“%@” を変換できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be converted because the output cannot preserve transparency. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力形式では透明部分を保持できないため、“%@” を変換できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be converted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を変換できませんでした。"
          }
        }
      }
    },
    "“%@” could not be edited because its HDR gain map cannot be preserved. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR ゲインマップを保持できないため、“%@” を編集できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be edited because the output container cannot preserve transparency. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力コンテナで透明部分を保持できないため、“%@” を編集できませんでした。元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” could not be processed: %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” を処理できませんでした: %2$@。"
          }
        }
      }
    },
    "“%@” could not be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を読み込めませんでした。"
          }
        }
      }
    },
    "“%@” could not be saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” を保存できませんでした。"
          }
        }
      }
    },
    "“%@” did not produce a verified SDR output. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” から検証済みの SDR 出力を作成できませんでした。元のファイルはそのまま残しました。"
          }
        }
      }
    },
    "“%@” does not allow copying. Ask the PDF owner for a copy with permission.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ではコピーが許可されていません。許可付きのコピーを PDF の所有者に依頼してください。"
          }
        }
      }
    },
    "“%@” does not allow printing. Ask the PDF owner for a copy with permission.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” では印刷が許可されていません。許可付きのコピーを PDF の所有者に依頼してください。"
          }
        }
      }
    },
    "“%@” does not contain what its name suggests.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の中身が拡張子と一致しません。"
          }
        }
      }
    },
    "“%@” exceeds the frame memory budget. Use fewer or smaller frames.": {
      "comment": "Limit protects available memory",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフレーム用のメモリ上限を超えています。フレーム数を減らすか、サイズを小さくしてください。"
          }
        }
      }
    },
    "“%@” had nothing to remove.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には削除するものがありませんでした。"
          }
        }
      }
    },
    "“%@” has characters on line %lld that Shift_JIS cannot represent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” の %2$lld 行目に Shift_JIS で表現できない文字があります。"
          }
        }
      }
    },
    "“%@” has multiple audio or video tracks. Replacement supports at most one of each.": {
      "comment": "Replacement would discard additional tracks",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には複数の音声トラックまたは映像トラックがあります。置き換えでは、それぞれ 1 つまでしか扱えません。"
          }
        }
      }
    },
    "“%@” is a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダです。"
          }
        }
      }
    },
    "“%@” is already SDR and was kept without re-encoding.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はすでに SDR のため、再エンコードせずにそのまま残しました。"
          }
        }
      }
    },
    "“%@” is already as small as it gets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はこれ以上小さくできません。"
          }
        }
      }
    },
    "“%@” is already smaller than the requested size.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はすでに指定サイズより小さいです。"
          }
        }
      }
    },
    "“%@” is empty.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は空です。"
          }
        }
      }
    },
    "“%@” is larger than %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は %2$@ を超えています。"
          }
        }
      }
    },
    "“%@” is longer than this preset allows (%@).": {
      "comment": "Platform preset duration limit; the Trim panel opens next",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はこのプリセットの上限 (%@) より長いです。"
          }
        }
      }
    },
    "“%@” is not a folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はフォルダではありません。"
          }
        }
      }
    },
    "“%@” is not a regular file or folder. Select a regular file or folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は通常のファイルまたはフォルダではありません。通常のファイルかフォルダを選択してください。"
          }
        }
      }
    },
    "“%@” is not valid JSON (line %lld, column %lld).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は正しい JSON ではありません (%2$lld 行、%3$lld 列)。"
          }
        }
      }
    },
    "“%@” is on a volume without a Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はゴミ箱のないボリュームにあります。"
          }
        }
      }
    },
    "“%@” is password-protected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はパスワードで保護されています。"
          }
        }
      }
    },
    "“%@” is protected by a password.": {
      "comment": "Archive extraction needs a password; the Password panel opens next",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はパスワードで保護されています。"
          }
        }
      }
    },
    "“%@” is too small for an icon.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はアイコンにするには小さすぎます。"
          }
        }
      }
    },
    "“%@” must be an array of flat objects; %@ is not.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” はフラットなオブジェクトの配列である必要があります。%2$@ が該当しません。"
          }
        }
      }
    },
    "“%@” needed no change.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は変更の必要がありませんでした。"
          }
        }
      }
    },
    "“%@” uses %@, which MacEase does not support.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” は MacEase が対応していない %2$@ を使用しています。"
          }
        }
      }
    },
    "“%@” uses HDR content that cannot be safely converted to SDR. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には安全に SDR に変換できない HDR コンテンツが含まれています。元のファイルはそのまま残しました。"
          }
        }
      }
    },
    "“%@” uses an unsupported video display transform. The original was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は対応していない表示変換を使用しているため、元のファイルはそのまま残しています。"
          }
        }
      }
    },
    "“%@” was not extracted because it expands to more than %@.": {
      "comment": "Archive extraction stopped by the zip bomb guard",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は展開後のサイズが %@ を超えるため、展開しませんでした。"
          }
        }
      }
    },
    "“%@” was not extracted because the entry “%@” points outside its folder.": {
      "comment": "Archive extraction refused a path traversal or absolute entry name",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の項目 “%@” が展開先のフォルダの外部を参照しているため、展開しませんでした。"
          }
        }
      }
    },
    "“%@”: %@": {
      "comment": "File warning in batch results",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”: %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
