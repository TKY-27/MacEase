        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフレームを使用"
          }
        }
      }
    },
    "Use for all %lld archives in this batch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この一括処理のすべてのアーカイブ (%lld 個) に使用"
          }
        }
      }
    },
    "V%lld (highest)": {
      "comment": "Best MP3 VBR quality level",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "V%lld (最高品質)"
          }
        }
      }
    },
    "V%lld (smallest)": {
