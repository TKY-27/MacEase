{
  "sourceLanguage": "en",
  "strings": {
    "%@ failed": {
      "comment": "Notification title when every item failed",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に失敗しました"
          }
        }
      }
    },
    "%lld done": {
      "comment": "Count of finished files",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件完了"
          }
        }
      }
    },
    "%lld failed": {
      "comment": "Count of failed files",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件失敗"
          }
        }
      }
    },
    "%lld of %lld restored": {
      "comment": "Undo notification body",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 件中 %1$lld 件を元に戻しました"
          }
        }
      }
    },
    "%lld skipped": {
      "comment": "Count of skipped files",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件スキップ"
          }
        }
      }
    },
    "Another file now uses the name “%@”.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” という名前は別のファイルが使用しています。"
          }
        }
      }
    },
    "Apple Intelligence is not available. Turn it on in System Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence を利用できません。システム設定でオンにしてください。"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Cancel a running batch",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。"
          }
        }
      }
    },
    "Check for Updates": {
      "comment": "Menu bar item",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認"
          }
        }
      }
    },
    "History was reset": {
      "comment": "Notification after unreadable history",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をリセットしました"
          }
        }
      }
    },
    "In Progress": {
      "comment": "Menu bar section title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        }
      }
    },
    "Loudness stopped at %@ LUFS to keep peaks below −1 dBTP.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピークを −1 dBTP 以下に保つため、ラウドネスは %@ LUFS で止めました。"
          }
        }
      }
    },
    "MacEase %@ Is Available…": {
      "comment": "Menu bar update item",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase %@ が公開されました…"
          }
        }
      }
    },
    "MacEase %@ is available": {
      "comment": "Update notification",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase %@ が公開されました"
          }
        }
      }
    },
    "MacEase needs access to %@ to process “%@”. Allow it in System Settings > Privacy & Security.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” を処理するには %1$@ へのアクセスが必要です。システム設定 > プライバシーとセキュリティで許可してください。"
          }
        }
      }
    },
    "No Java runtime was found. Install Java to decompile JAR files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Java ランタイムが見つかりません。JAR を逆コンパイルするには Java をインストールしてください。"
          }
        }
      }
    },
    "No pages were selected from “%@”.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” のページが選択されていません。"
          }
        }
      }
    },
    "Only the first frame was kept because the format has no animation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式はアニメーションに対応していないため、最初のフレームのみを保存しました。"
          }
        }
      }
    },
    "Only the first page was kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のページのみを保存しました。"
          }
        }
      }
    },
    "Open the menu bar menu to see the release.": {
      "comment": "Update notification",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのメニューからリリースを確認できます。"
          }
        }
      }
    },
    "Please choose the item again.": {
      "comment": "Stale menu notification body",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度項目を選んでください。"
          }
        }
      }
    },
    "Quit MacEase": {
      "comment": "Menu bar item",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase を終了"
          }
        }
      }
    },
    "Recent": {
      "comment": "Menu bar section title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の処理"
          }
        }
      }
    },
    "Settings…": {
      "comment": "Menu bar item",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "Show in Finder": {
      "comment": "Notification action that reveals outputs",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder で表示"
          }
        }
      }
    },
    "Something went wrong with “%@”. Details are in the log.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の処理中に問題が発生しました。詳細はログを確認してください。"
          }
        }
      }
    },
    "Speech recognition for this language is not installed yet. Try again after it downloads.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語の音声認識はまだインストールされていません。ダウンロード後にもう一度お試しください。"
          }
        }
      }
    },
    "The MacEase menu was updated": {
      "comment": "Stale menu notification title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase のメニューが更新されました"
          }
        }
      }
    },
    "The old history was kept as %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の履歴は %@ として保存しました。"
          }
        }
      }
    },
    "The original could not be moved to the Trash, so both files were kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルをゴミ箱に移動できなかったため、両方のファイルを残しました。"
          }
        }
      }
    },
    "The original of “%@” is no longer in the Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の元のファイルはゴミ箱にありません。"
          }
        }
      }
    },
    "The output format cannot hold the original metadata.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力形式は元のメタデータを保持できません。"
          }
        }
      }
    },
    "The text encoding of “%@” could not be detected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” の文字コードを判別できませんでした。"
          }
        }
      }
    },
    "The translation languages are not downloaded. Download them in System Settings > General > Language & Region.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳用の言語がダウンロードされていません。システム設定 > 一般 > 言語と地域でダウンロードしてください。"
          }
        }
      }
    },
    "The volume has no Trash, so the original was kept next to the result.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームにゴミ箱がないため、元のファイルは結果の隣に残しました。"
          }
        }
      }
    },
    "This Mac has no hardware encoder for this format.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはこの形式のハードウェアエンコーダがありません。"
          }
        }
      }
    },
    "Undo": {
      "comment": "Notification title after undo",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        }
      }
    },
    "Undo is unavailable because the history could not be saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を保存できなかったため、取り消しはできません。"
          }
        }
      }
    },
    "Undone": {
      "comment": "Recent batch state",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消し済み"
          }
        }
      }
    },
