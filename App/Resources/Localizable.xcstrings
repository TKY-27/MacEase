    "Move the old MacEase in Applications to the Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリケーション」にある古い MacEase をゴミ箱に移動してください。"
          }
        }
      }
    },
    "Open the downloaded file and drag MacEase into Applications.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルを開き、MacEase を「アプリケーション」にドラッグしてください。"
          }
        }
      }
    },
    "Open MacEase.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacEase を開いてください。"
          }
        }
      }
    },
    "Turn on MacEase again in System Settings > General > Login Items & Extensions > Finder, and allow folder and privacy access again when macOS asks.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」>「一般」>「ログイン項目と機能拡張」>「Finder」で MacEase を再びオンにしてください。macOS から確認を求められたら、フォルダへのアクセスやプライバシー関連の権限も再び許可してください。"
          }
        }
      }
    },
    "Open Extension Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能拡張の設定を開く"
          }
        }
